<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                
                <Button
                    android:id="@+id/btnPrevDay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="&lt;"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#222222"
                    app:cornerRadius="24dp"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WINTER ARC"
                        android:textColor="@color/textPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/montserrat_bold"/>

                    <TextView
                        android:id="@+id/tvCurrentDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oct 1, 2026"
                        android:textColor="#AEE6FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnNextDay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="&gt;"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#222222"
                    app:cornerRadius="24dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DAILY CHALLENGES"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"/>
                <Button
                    android:id="@+id/btnEditGoals"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="EDIT GOALS"
                    android:textSize="10sp"
                    android:textColor="#000000"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"/>
            </LinearLayout>

            <!-- Habit Grid -->
            <GridLayout
                android:id="@+id/habitGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">
                <!-- Buttons added dynamically in Java -->
            </GridLayout>

            <!-- Sleep Tracker -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/glass_card">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SLEEP TRACKER"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:letterSpacing="0.2"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">
                        
                        <Button
                            android:id="@+id/btnMinus"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:text="-"
                            android:textColor="@color/textPrimary"
                            android:textSize="24sp"
                            android:backgroundTint="#222222"
                            app:cornerRadius="30dp"/>
                            
                        <TextView
                            android:id="@+id/tvSleepHours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="8.0"
                            android:textColor="@color/textPrimary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/montserrat_bold"/>
                            
                        <Button
                            android:id="@+id/btnPlus"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:text="+"
                            android:textColor="@color/textPrimary"
                            android:textSize="24sp"
                            android:backgroundTint="#222222"
                            app:cornerRadius="30dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Graph Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/glass_card">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Performance Graph"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/montserrat_bold" />
                            
                        <Button
                            android:id="@+id/btnGraphType"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Sleep ▼"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/montserrat_bold"
                            android:backgroundTint="#333333"
                            app:cornerRadius="18dp" />
                    </RelativeLayout>
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="16dp"
                        android:background="#0F0F13"
                        android:padding="8dp">
                        
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/progressChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="32dp"
                            android:layout_marginBottom="24dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESULTS"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:rotation="-90"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="-12dp" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIME"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="4dp" />
                    </RelativeLayout>
                        
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:id="@+id/btnContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnJourney"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="WEEKLY / MONTHLY REPORT"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="8dp"
            app:cornerRadius="30dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
